{
  "name": "ai-orbit-cube",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A self-contained, static-hostable 3D Rubik's cube of six evolving AI worlds.",
  "scripts": {
    "dev": "npm run build:standalone && vite --host 0.0.0.0",
    "build:standalone": "vite build --config vite.standalone.config.js",
    "build": "npm run build:standalone && node scripts/copy-docs.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "test:unit": "node --test tests/logic.test.js",
    "test:e2e": "node --test tests/browser.test.js",
    "check": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.64.0",
    "vite": "8.3.4"
  }
}
